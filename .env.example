# ==============================================================================
# PrathGPT Environment Configuration Template
# Copy this file to .env and fill in your actual API keys.
# Do not commit your actual .env file with real credentials to version control.
# ==============================================================================

# --- LLM Provider (Required) ---
# Mistral AI API key for chat completion and reasoning
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Embeddings for RAG (Required) ---
# Google Gemini API key for gemini-embedding-001 dense embeddings
GOOGLE_API_KEY=your_google_api_key_here

# --- Web Search Tool (Required) ---
# Tavily Search API key for real-time web information retrieval
TAVILY_API_KEY=your_tavily_api_key_here

# --- Optional External API Tools ---
# OpenWeatherMap API key for live weather data
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AlphaVantage API key for real-time stock quotes and ticker analysis
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# --- LangSmith Observability & Tracing (Optional) ---
# Set to true to enable LangSmith dashboard logging, or false to disable
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=prathgpt
